// Crafted Studio booking system.
//
// Everything the salon can change lives in these tables, so the admin panel is
// plain CRUD and no prices, durations, staff or opening hours are hardcoded in
// the app.
//
// TIME: every instant is stored UTC (`DateTime`). Opening hours, staff shifts
// and breaks are stored as minutes-from-midnight in the salon's own timezone
// (Settings.timezone, America/Winnipeg), because "10:00" must stay 10:00 across
// a daylight saving change. Converting between the two happens in one place, in
// lib/time.
//
// MONEY: always integer cents. A float cannot hold 0.1 exactly and rounding
// errors in money are not recoverable.

// Prisma 7: the generator needs an explicit output, and the connection URL
// lives in prisma.config.ts rather than here.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people

enum Role {
  OWNER // sees and edits everything
  STAFF // sees own calendar, edits own availability
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  // A STAFF login is tied to the barber they are; an OWNER login need not be.
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId      String?   @unique
  payments     Payment[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Staff {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  title    String  @default("") // "Master Barber"
  bio      String  @default("")
  email    String?
  phone    String?
  imageUrl String?
  // Calendar colour for this barber, as #rrggbb.
  color    String  @default("#C8A46A")
  /// Share of each service this barber earns, as a whole percent. 0 = not tracked.
  commissionPercent Int     @default(0)
  active            Boolean @default(true)
  sortOrder         Int     @default(0)

  login        AdminUser?
  services     StaffService[]
  hours        StaffHours[]
  breaks       StaffBreak[]
  timeOff      TimeOff[]
  specialDates SpecialDate[]
  appointments Appointment[]
  preferredBy  Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- menu

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String // "Men's", "Colour"
  slug      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  services  Service[]
}

enum PriceMode {
  FIXED // price is exact — charge it in full
  FROM // "from $X" — charge the deposit, balance in salon
  CONSULTATION // price unknown — request only, no card
}

model Service {
  id          String          @id @default(cuid())
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId  String
  name        String
  slug        String          @unique
  description String          @default("")
  imageUrl    String?

  priceCents   Int       @default(0)
  priceMode    PriceMode @default(FIXED)
  // Charged up front when priceMode is FROM. Ignored otherwise.
  depositCents Int       @default(0)

  durationMinutes Int
  // Cleanup/turnaround after the appointment; blocks the calendar, not billed.
  bufferMinutes   Int     @default(0)
  // Optional per-service calendar colour; falls back to the barber's colour.
  color           String?
  popular         Boolean @default(false)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  staff        StaffService[]
  addOns       AddOnService[]
  coupons      CouponService[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
}

// Which barber can perform which service, and their own price/duration if it
// differs from the service default.
model StaffService {
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  priceCents      Int?
  durationMinutes Int?

  @@id([staffId, serviceId])
  @@index([serviceId])
}

model AddOn {
  id              String  @id @default(cuid())
  name            String
  priceCents      Int     @default(0)
  durationMinutes Int     @default(0)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  services     AddOnService[]
  appointments AppointmentAddOn[]
}

// An add-on with no rows here is offered on every service.
model AddOnService {
  addOn     AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  addOnId   String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  @@id([addOnId, serviceId])
  @@index([serviceId])
}

// ---------------------------------------------------------------- opening times

// Salon-wide opening hours. One row per weekday (0 = Sunday).
model BusinessHours {
  dayOfWeek   Int     @id // 0-6
  closed      Boolean @default(false)
  openMinute  Int     @default(600) // 10:00
  closeMinute Int     @default(1200) // 20:00
}

// A barber's normal working week. Missing row for a day = not working that day.
model StaffHours {
  id          String @id @default(cuid())
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  @@unique([staffId, dayOfWeek])
}

/// A recurring unbookable gap in a barber's day — lunch, a standing commitment.
model StaffBreak {
  id          String @id @default(cuid())
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  label       String @default("Break")

  @@index([staffId, dayOfWeek])
}

enum SpecialDateType {
  CLOSED // holiday, or one barber's day off
  CUSTOM_HOURS // open, but not the usual times
}

// One-off overrides for a whole date. `staffId` null means the whole salon.
model SpecialDate {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  type        SpecialDateType @default(CLOSED)
  openMinute  Int?
  closeMinute Int?
  note        String          @default("")
  staff       Staff?          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String?

  @@unique([date, staffId])
  @@index([date])
}

// Part of a single day blocked out for one barber.
model TimeOff {
  id       String   @id @default(cuid())
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId  String
  startsAt DateTime
  endsAt   DateTime
  note     String   @default("")

  @@index([staffId, startsAt])
}

// ---------------------------------------------------------------- customers

model Customer {
  id    String @id @default(cuid())
  email String @unique
  name  String
  phone String
  notes String @default("")

  /// Set explicitly by staff; the booking history says who they actually see.
  preferredStaff   Staff?  @relation(fields: [preferredStaffId], references: [id], onDelete: SetNull)
  preferredStaffId String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([name])
}

// ---------------------------------------------------------------- bookings

enum AppointmentStatus {
  PENDING // created, awaiting payment where payment is required
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  NOT_REQUIRED // consultation bookings
  PENDING
  PAID // full amount taken
  DEPOSIT_PAID // deposit taken, balance due in salon
  REFUNDED
  FAILED
}

/// Where a booking came from — online self-service, the admin panel, or the door.
enum AppointmentSource {
  ONLINE
  ADMIN
  WALK_IN
}

model Appointment {
  id String @id @default(cuid())
  // Short human code for emails and the cancel link, e.g. "CS-7F3K2A".
  code String @unique

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId    String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId  String

  // startsAt/endsAt are UTC. endsAt already includes add-ons and the buffer, so
  // overlap checks never have to re-derive a duration.
  startsAt DateTime
  endsAt   DateTime

  status        AppointmentStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(PENDING)
  source        AppointmentSource @default(ONLINE)

  // Copied from the service at booking time: a later price change must not
  // rewrite what the customer was quoted.
  priceCents    Int
  discountCents Int    @default(0)
  taxCents      Int    @default(0)
  paidCents     Int    @default(0)
  currency      String @default("CAD")

  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId String?

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  customerNote String             @default("")
  staffNote    String             @default("")
  addOns       AppointmentAddOn[]
  payments     Payment[]
  notifications NotificationLog[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([staffId, startsAt])
  @@index([startsAt])
  @@index([status])
  @@index([customerId])
}

model AppointmentAddOn {
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId   String
  addOn           AddOn       @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  addOnId         String
  priceCents      Int
  durationMinutes Int

  @@id([appointmentId, addOnId])
}

// ---------------------------------------------------------------- money taken

enum PaymentMethod {
  CASH
  CARD // terminal in the salon
  ONLINE // Stripe
  OTHER
}

enum PaymentState {
  PENDING
  PAID
  REFUNDED
  FAILED
}

/// One movement of money against an appointment. An appointment can have
/// several: a deposit online, the balance in cash, then a partial refund.
model Payment {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String

  amountCents   Int
  refundedCents Int           @default(0)
  method        PaymentMethod @default(CARD)
  status        PaymentState  @default(PAID)
  /// Stripe id, terminal receipt number, or whatever the salon writes down.
  reference     String?
  note          String        @default("")

  takenBy   AdminUser? @relation(fields: [takenById], references: [id], onDelete: SetNull)
  takenById String?

  createdAt DateTime @default(now())

  @@index([appointmentId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- discounts

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String     @default("")
  type          CouponType @default(PERCENT)
  /// Percent (1-100) when type is PERCENT, otherwise cents off.
  value         Int
  minSpendCents Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  /// Null means unlimited.
  usageLimit    Int?
  usedCount     Int        @default(0)
  /// False restricts it to the services listed in `services`.
  appliesToAll  Boolean    @default(true)
  active        Boolean    @default(true)

  services     CouponService[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponService {
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId  String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String

  @@id([couponId, serviceId])
  @@index([serviceId])
}

// ---------------------------------------------------------------- notifications

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULED
  ADMIN_NEW_BOOKING
  ADMIN_CANCELLATION
  ADMIN_PAYMENT
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationState {
  QUEUED
  SENT
  FAILED
}

/// A record of every message the system sent, so the salon can see what a
/// customer was told and a failure is visible rather than silent.
model NotificationLog {
  id      String              @id @default(cuid())
  type    NotificationType
  channel NotificationChannel @default(EMAIL)
  state   NotificationState   @default(QUEUED)

  toAddress String
  subject   String  @default("")
  error     String?

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String?

  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([createdAt])
  @@index([appointmentId])
}

// ---------------------------------------------------------------- settings

// Single row, id = 1.
model Settings {
  id Int @id @default(1)

  // --- general
  salonName    String @default("Crafted Studio")
  logoUrl      String @default("/images/logo.webp")
  addressLine1 String @default("2003-1480 Dakota Street")
  addressLine2 String @default("Winnipeg, Manitoba R2N 3Y7")
  phone        String @default("")
  notifyEmail  String @default("crafted.studio@outlook.com")

  timezone String @default("America/Winnipeg")
  currency String @default("CAD")

  // --- booking rules
  /// Start times are offered every N minutes.
  slotIntervalMinutes Int     @default(15)
  /// How soon before a slot someone may still book it.
  minNoticeMinutes    Int     @default(120)
  /// How far ahead the calendar is open.
  maxAdvanceDays      Int     @default(60)
  /// Free cancellation window; inside it, a paid booking is not auto-refunded.
  cancelNoticeHours   Int     @default(24)
  /// Added to every service that does not set its own buffer.
  defaultBufferMinutes Int    @default(0)
  allowSameDayBooking  Boolean @default(true)
  cancellationPolicy   String  @default("Please give at least 24 hours' notice to cancel or reschedule.")

  // --- payments
  taxPercent        Int     @default(0)
  onlinePayments    Boolean @default(false)

  // --- notifications
  notifyCustomerConfirmation Boolean @default(true)
  notifyCustomerReminder     Boolean @default(true)
  notifyCustomerCancellation Boolean @default(true)
  notifyAdminNewBooking      Boolean @default(true)
  notifyAdminCancellation    Boolean @default(true)
  reminderHoursBefore        Int     @default(24)

  updatedAt DateTime @updatedAt
}
