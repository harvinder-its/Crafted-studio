# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- database
# Neon Postgres connection string (Dashboard → Connect → Prisma).
# Use the POOLED host (it contains "-pooler") for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------- admin login
# Signs the admin session cookie. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# First owner account, created by `npm run db:seed`.
SEED_OWNER_EMAIL=crafted.studio@outlook.com
# Left blank, the seed generates a password and writes it here.
SEED_OWNER_PASSWORD=

# ---------------------------------------------------------------- payments
# Stripe → Developers → API keys. Use the test keys (sk_test_/pk_test_) first.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends customers back to. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- email
# Without these two, bookings are still taken and recorded — no email is sent,
# and the reason is shown in Admin → Settings → Notifications → Delivery log.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Must be a verified sender on your Resend domain, or Resend refuses the send.
BOOKING_FROM_EMAIL="Crafted Studio <bookings@yourdomain.ca>"

# Where booking notifications are delivered. Normally leave this blank: the
# address under Admin → Settings → General is used, so it can be changed
# without a redeploy. This is only the fallback for when that one is empty.
BOOKING_TO_EMAIL=
