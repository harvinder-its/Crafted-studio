# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- database
# Neon Postgres connection string (Dashboard → Connect → Prisma).
# Use the POOLED host — it contains "-pooler" — so the app shares connections
# rather than opening one per request.
#
# The site only reads from it: the service menu, prices, opening hours and
# contact details. Bookings are handled by a separate system.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------- site
# The public address, no trailing slash. Used for canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
