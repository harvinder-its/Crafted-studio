# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- database
# MySQL on SiteGround: Site Tools → Site → MySQL → Databases.
# Create a database and a user, grant the user full access, then:
#   mysql://DBUSER:PASSWORD@HOST:3306/DBNAME
#
# HOST is "localhost" when the app runs on the same SiteGround account, which
# is the normal case and the fastest. Use the server hostname only when
# connecting from elsewhere, and whitelist that IP first under Remote MySQL.
# Append ?ssl=true for a remote connection.
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# Connections this app may hold at once. Shared hosting caps the account total,
# so leave this small unless SiteGround says otherwise.
DATABASE_POOL_SIZE=5

# Only needed while moving off Neon — `npm run db:export` reads it. Delete
# once the data is in MySQL and the new site is proven.
NEON_DATABASE_URL=

# ---------------------------------------------------------------- admin login
# Signs the admin session cookie. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# First owner account, created by `npm run db:seed`.
SEED_OWNER_EMAIL=crafted.studio@outlook.com
# Left blank, the seed generates a password and writes it here.
SEED_OWNER_PASSWORD=

# ---------------------------------------------------------------- payments
# Stripe → Developers → API keys. Use the test keys (sk_test_/pk_test_) first.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends customers back to. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- email
# Any mailbox that can send over SMTP. Without these, bookings are still taken
# and recorded — no email goes out, and the reason is shown in
# Admin → Settings → Notifications → Delivery log.
#
#   Namecheap Private Email  mail.privateemail.com   port 465
#   Outlook / Microsoft 365  smtp.office365.com      port 587
#   Gmail / Google Workspace smtp.gmail.com          port 587
#
# Use an app password, not the account password: Gmail and Microsoft both
# require one once two-factor is on, and it can be revoked on its own.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Only set this if the mailbox is allowed to send as another address. Most
# refuse, so it defaults to SMTP_USER.
BOOKING_FROM_EMAIL=

# Where booking notifications are delivered. Normally leave this blank: the
# address under Admin → Settings → General is used, so it can be changed
# without a redeploy. This is only the fallback for when that one is empty.
BOOKING_TO_EMAIL=
